NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Docker values; when running without Docker use localhost instead.
DATABASE_URL=postgresql://reachx:reachx_dev_password@postgres:5432/reachx?schema=public
REDIS_URL=redis://redis:6379

# Generate with a password manager: do not commit real values.
JWT_SECRET=replace-with-a-32-character-or-longer-random-value
SESSION_SECRET=replace-with-a-different-random-value

# Temporary local credential login. Change these before sharing the app.
LOCAL_LOGIN_EMAIL=oliver.brown@domain.io
LOCAL_LOGIN_PASSWORD=password123

# Google Cloud OAuth web-client credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK=http://localhost:5000/api/auth/google/callback

# Ethereal SMTP account credentials.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ReachX Scheduler <your-ethereal-address>"

WORKER_CONCURRENCY=5
MAX_EMAILS_PER_HOUR=200
DEFAULT_DELAY_SECONDS=2
